# ---- 送り先（ジェネシスワークシステム） ----
GENESIS_ENDPOINT=https://gws.example.co.jp/api/schedules/google-sync
GENESIS_TOKEN=GWS側で発行したトークン

# ---- 同期する社員 ----
# Workspace の管理者アカウント（全社員の一覧を取得するために使う。実際の操作はしない）
ADMIN_EMAIL=admin@example.co.jp
# 全社員ではなく特定の人だけにする場合はこちら（カンマ区切り。指定すると ADMIN_EMAIL より優先）
# SYNC_USERS=takezawa@example.co.jp,tanaka@example.co.jp
# 同期しない人（共有アカウントなど）
# EXCLUDE_USERS=info@example.co.jp,noreply@example.co.jp
# 複数ドメインのうち 1 つだけにする場合
# SYNC_DOMAIN=example.co.jp

# ---- 認証（どちらか） ----
# Cloud Run で動かす場合: 何も設定しなくてよい（実行サービスアカウントで署名する）
# 鍵ファイルを使う場合:
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# ---- 同期状態の保存先 ----
# STATE_STORE=gs://バケット名/genesis-sync/state.json   # Cloud Run の場合
STATE_STORE=./state.json

# 初回に送る範囲（何日前以降の予定か）
INITIAL_DAYS_BACK=30

# 1 にすると GWS へ送らず件数だけ表示（動作確認用）
DRY_RUN=0
