// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ApplicantStatus {
  BASIC_INFO_SUBMITTED
  SLOT_SELECTED
  SHEET_SUBMITTED
  INTERVIEW_DONE
  CANCELLED
}

enum NotificationType {
  APPLICATION_RECEIVED
  SCHEDULE_CONFIRMED
  SHEET_REMINDER
  INTERVIEW_REMINDER
}

model Applicant {
  id               String    @id @default(cuid())
  name             String
  nameKana         String?
  email            String
  phone            String
  birthDate        DateTime?
  address          String?
  desiredPosition  String?
  source           String? // 応募元の求人媒体
  status           ApplicantStatus @default(BASIC_INFO_SUBMITTED)
  lineLinkCode     String    @unique @default(cuid())
  lineUserId       String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointment      Appointment?
  interviewSheet   InterviewSheet?
  notifications    Notification[]
}

model AvailabilitySlot {
  id          String   @id @default(cuid())
  startAt     DateTime
  endAt       DateTime
  capacity    Int      @default(1)
  note        String?
  createdAt   DateTime @default(now())

  appointments Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  applicantId String    @unique
  slot        AvailabilitySlot @relation(fields: [slotId], references: [id])
  slotId      String
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
}

model InterviewSheet {
  id          String   @id @default(cuid())
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  applicantId String    @unique
  // 実際の面談シート項目が確定するまでは JSON で柔軟に保持する
  answers     String
  submittedAt DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  applicantId String
  type        NotificationType
  message     String
  success     Boolean  @default(true)
  error       String?
  sentAt      DateTime @default(now())
}
