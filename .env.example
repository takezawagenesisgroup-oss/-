# PostgreSQL connection string.
# - Local dev: point at a local Postgres (see README), e.g.
#   postgresql://postgres:password@127.0.0.1:5432/facility_tool_dev
# - Vercel: created automatically when you add "Postgres" storage to the
#   project (Storage tab -> Create Database -> Postgres) and connect it.
POSTGRES_URL=

# Random string used to sign login session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Optional. When set, uploaded work-record photos are stored in Vercel Blob
# instead of the local public/uploads folder. Created automatically when you
# add "Blob" storage to the Vercel project and connect it.
BLOB_READ_WRITE_TOKEN=
